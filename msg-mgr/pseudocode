/* ------------------------------------------------------------
 * PSEUDOCODE: Non-stop (cyclic) harness for msg-mgr model
 * Style A: bounded iterations + per-iteration reset + scenario re-run
 *
 * Goal:
 *  - keep RTEMS API semantics unchanged (send/receive/create)
 *  - represent ongoing operation by repeatedly executing scenarios
 *  - keep SPIN terminating in TEST_GEN by bounding MAX_ITERATIONS
 *
 * Key idea:
 *  - start System() + Clock() ONCE
 *  - add a KEEPALIVE task so System never sees "all Zombies" mid-loop
 *  - loop: reset -> chooseScenario -> run Sender/Receiver1/Receiver2 -> wait done
 *  - end: set keepalive Zombie so System can stop Clock and terminate
 * ------------------------------------------------------------ */

/* Existing IDs in msg-mgr */
#define SEND_ID      1
#define RCV1_ID      2
#define RCV2_ID      3

/* Add one extra task entry for keepalive
 * (in msg-mgr.pml change TASK_MAX from 4 -> 5)
 */
#define TASK_MAX       5
#define KEEPALIVE_ID   4

/* Bound iterations for test generation */
#define MAX_ITERATIONS  3

/* Helper: reset all per-iteration model state to avoid carry-over.
 * This MUST cover:
 *   - msgstate[*] fields that scenario changes
 *   - queueCreated/queueId and queueList contents
 *   - sync semaphores (sendSema/rcvSema1/rcvSema2/startSema + test_sync_sema[])
 *   - per-task timeout bookkeeping (ticks/tout) for participating tasks
 *
 * NOTE: do not change message_queue_* API inlines; reset is harness-only.
 */
inline reset_iteration_state() {

  /* Reset per-task bookkeeping that impacts blocking/timeouts */
  tasks[SEND_ID].ticks = 0; tasks[SEND_ID].tout = false;
  tasks[RCV1_ID].ticks = 0; tasks[RCV1_ID].tout = false;
  tasks[RCV2_ID].ticks = 0; tasks[RCV2_ID].tout = false;

  /* Optional: clear task states (the proctypes also set these, but safe) */
  tasks[SEND_ID].state = Ready;
  tasks[RCV1_ID].state = Ready;
  tasks[RCV2_ID].state = Ready;

  /* Reset sync semaphores */
  test_sync_sema[0] = false;
  test_sync_sema[1] = false;
  test_sync_sema[2] = false;

  /* Reset global return codes */
  sendrc = RC_OK;
  recrc  = RC_OK;
  qrc    = RC_OK;

  /* Reset scenario globals */
  sendTarget = 0;
  msize = MAX_MESSAGE_SIZE;
  sendAgain = false;
  totalSendCount = 0;
  currSendCount  = 0;

  /* Reset queue lifecycle flags */
  queueCreated = false;
  queueId = 1;

  /* Reset msgstate slices for participating tasks */
  /* (Keep domains small to avoid blow-up; chooseScenario will overwrite many anyway) */
  msgstate[SEND_ID].rcvInterval = 0;
  msgstate[SEND_ID].rcvMsg = 0;
  msgstate[SEND_ID].sndMsg = 0;
  msgstate[SEND_ID].targetQueue = queueId;
  msgstate[SEND_ID].numSends = 1;
  msgstate[SEND_ID].msgSize = MAX_MESSAGE_SIZE;
  msgstate[SEND_ID].doCreate = true;
  msgstate[SEND_ID].doSend = false;
  msgstate[SEND_ID].doReceive = false;
  msgstate[SEND_ID].doWait = false;

  msgstate[RCV1_ID].rcvInterval = 0;
  msgstate[RCV1_ID].rcvMsg = 0;
  msgstate[RCV1_ID].sndMsg = 0;
  msgstate[RCV1_ID].targetQueue = queueId;
  msgstate[RCV1_ID].numSends = 0;
  msgstate[RCV1_ID].msgSize = 0;
  msgstate[RCV1_ID].doCreate = false;
  msgstate[RCV1_ID].doSend = false;
  msgstate[RCV1_ID].doReceive = false;
  msgstate[RCV1_ID].doWait = false;

  msgstate[RCV2_ID].rcvInterval = 0;
  msgstate[RCV2_ID].rcvMsg = 0;
  msgstate[RCV2_ID].sndMsg = 0;
  msgstate[RCV2_ID].targetQueue = queueId;
  msgstate[RCV2_ID].numSends = 0;
  msgstate[RCV2_ID].msgSize = 0;
  msgstate[RCV2_ID].doCreate = false;
  msgstate[RCV2_ID].doSend = false;
  msgstate[RCV2_ID].doReceive = false;
  msgstate[RCV2_ID].doWait = false;

  /* Reset receive out locations (if used by test builder) */
  recout[SEND_ID] = 0;
  recout[RCV1_ID] = 0;
  recout[RCV2_ID] = 0;

  /* Reset queueList entries likely used.
   * In this model, only queueId=1 is effectively used in create().
   * Still, reset all to avoid stale wait queues/messages.
   */
  int q = 0;
  do
  :: (q == MAX_MESSAGE_QUEUES) -> break
  :: else ->
      queueList[q].config.name = 0;
      queueList[q].config.count = 0;
      queueList[q].config.maxSize = 0;
      queueList[q].queueFull = false;
      queueList[q].head = 0;
      queueList[q].tail = 0;

      /* clear message buffer */
      int mi = 0;
      do
      :: (mi == MAX_PENDING_MESSAGES) -> break
      :: else ->
          queueList[q].messages[mi] = 0;
          mi++
      od

      /* clear task wait queue */
      int ti = 0;
      do
      :: (ti == TASK_MAX) -> break
      :: else ->
          queueList[q].waitingTasks[ti] = 0;
          ti++
      od
      queueList[q].nextTask = 0;
      queueList[q].lastTask = 0;
      queueList[q].taskFull = false;

      q++
  od
}

/* Wait until the three participating tasks complete this iteration */
inline wait_iteration_complete() {
  do
  :: (tasks[SEND_ID].state == Zombie &&
      tasks[RCV1_ID].state == Zombie &&
      tasks[RCV2_ID].state == Zombie) -> break
  :: else -> skip
  od
}

/* Main harness */
init {

  /* --- One-time setup (keep original metadata style) --- */
  printf("@@@ %d NAME Message_Manager_NonStop\n", _pid);
  outputDefines();
  outputDeclarations();

  printf("@@@ %d INIT\n", _pid);

  /* Start background processes ONCE */
  run System();
  run Clock();

  /* Keepalive prevents System from stopping Clock between iterations.
   * Choose a state System will not change (it only changes OtherWait).
   * Use MsgWait/EventWait/Blocked — pick one that the msg-mgr logic never touches
   * for KEEPALIVE_ID. MsgWait is fine as long as we never enqueue KEEPALIVE_ID.
   */
  tasks[KEEPALIVE_ID].state = MsgWait;
  printf("@@@ %d STATE %d MsgWait (keepalive)\n", _pid, KEEPALIVE_ID);

  /* --- Scenario loop --- */
  byte iters = 0;

  do
#ifdef TEST_GEN
  :: (iters < MAX_ITERATIONS) ->
#else
  :: true ->
#endif
      iters++;

      printf("@@@ %d LOG non-stop iteration %d\n", _pid, iters);

      /* Reset + scenario choice atomically */
      atomic {
        reset_iteration_state();
        chooseScenario();
      }

      /* Run one scenario instance */
      run Sender(SEND_ID);
      run Receiver1(RCV1_ID);
      run Receiver2(RCV2_ID);

      /* Ensure no overlap with next iteration */
      wait_iteration_complete();

      printf("@@@ %d LOG iteration %d complete\n", _pid, iters);

#ifdef TEST_GEN
  :: else -> break
#endif
  od

  /* --- Controlled termination --- */
  tasks[KEEPALIVE_ID].state = Zombie;
  printf("@@@ %d STATE %d Zombie (keepalive stop)\n", _pid, KEEPALIVE_ID);

#ifdef TEST_GEN
  assert(false);
#endif

  printf("@@@ %d LOG Message Manager NonStop finished\n", _pid);
}
